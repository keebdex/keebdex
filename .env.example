# Cloudflare: [build] = Settings → Build → Variables and secrets
#             [runtime] = Settings → Variables and Secrets (prefer Secret)

# [build + runtime]
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=

# [runtime] at least 32 characters
NUXT_APP_SECRET=

# [runtime] image uploads
NUXT_CLOUDFLARE_ACCOUNT_ID=
NUXT_CLOUDFLARE_IMAGES_API_TOKEN=

# [build + runtime] optional, defaults shown
# Logos (brands, makers, profiles)
# NUXT_PUBLIC_IMG_URL=https://img.keebdex.org
# Cloudflare Images account hash (https://imagedelivery.net/<hash>/…); only
# images on it are resized
# NUXT_PUBLIC_CLOUDFLARE_ACCOUNT_HASH=AoGTnmznzkqXfjeHrFtGwg
